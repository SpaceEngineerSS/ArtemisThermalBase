# ==============================================================================
# ArtemisThermalBase — .gitignore
# ==============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Data files (large binaries, not for git) ---
data/*.tif
data/*.TIF
data/*.bsp
data/*.BSP
data/*.npy
data/*.npz
data/_download_tmp.*
data/**/*.tif
data/**/*.TIF
data/**/*.bsp
data/**/*.BSP
data/**/*.bpc
data/**/*.tls
data/**/*.tf
data/**/*.part
data/**/*.tiff
data/raw/
data/processed/

# --- Simulation output ---
output/
output_*/
results/
*.npy
*.npz

# --- Images: only the documentation figures are versioned ---
*.png
!docs/**/*.png
!artemis_thermal/assets/**/*.png

# --- Logs ---
*.log

# --- Numba / JIT cache ---
numba_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Coverage ---
htmlcov/
.coverage
.coverage.*

# --- tool caches ---
.mypy_cache/
.ruff_cache/

# --- pytest ---
.pytest_cache/

# --- Docs site build ---
docs/_site/
